DOMAIN=vannampham.sixpilot.technology
BASE_URL=https://vannampham.sixpilot.technology
PORT=3000
# Neon Postgres connection string. Leave empty for local dev (an embedded PGlite
# database is used automatically). Required in production for a persistent
# question bank, leaderboard, skill profiles, and the P2-3 economy
# (wallet / coin_ledger / unlocks). Without it the economy routes answer
# `disabled: true` and the game keeps running on the local wallet.
DATABASE_URL=
DATABASE_PATH=
CERTBOT_EMAIL=
JWT_SECRET=replace-with-a-long-random-secret
# Mật khẩu quản trị "gốc". Từ P2-7 đã có bảng `admin_users` (nhiều tài khoản, mỗi
# thầy cô một tài khoản riêng), nhưng biến này VẪN LÀ MỘT CHÌA KHOÁ HỢP LỆ cho
# riêng tài khoản `admin` — cố ý, để không ai bị khoá cửa lúc di trú và để còn
# đường vào khi quên mật khẩu trong bảng.
# ⇒ Sau khi đã tạo xong tài khoản riêng cho từng thầy cô, HÃY XOÁ biến này rồi
#   deploy lại. Chừng nào nó còn, mật khẩu cũ vẫn vào được.
ADMIN_PASSWORD_HASH=replace-with-output-from-npm-run-hash-password

# P1-4 — chống gian lận bảng xếp hạng.
# 0 / rỗng (mặc định): điểm nộp KHÔNG kèm vé ván chơi vẫn được nhận nhưng ghi
#   `verified = false`. Giữ nguyên như vậy trong lúc còn máy đang chạy client V1.
# 1: TỪ CHỐI hẳn điểm không kèm vé. Chỉ bật ở bước "Checklist release P1", sau khi
#   đã xác nhận toàn bộ máy học sinh chạy V2.
ANTICHEAT_ENFORCE=
